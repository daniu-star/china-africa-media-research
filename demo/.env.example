# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB配置（可选）
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=distributed_crawler
MONGO_USERNAME=admin
MONGO_PASSWORD=password123

# 主节点配置
MASTER_HOST=localhost
MASTER_PORT=8000
STORAGE_TYPE=file  # file, redis, mongodb
DATA_DIR=./distributed_data

# 工作节点配置
WORKER_ID=worker-1
MAX_THREADS=10
PROXY_ENABLED=false
PROXY_FILE=proxies.txt

# 爬虫配置
MAX_ARTICLES_PER_KEYWORD=100
REQUEST_TIMEOUT=30
USER_AGENT_ROTATION=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=distributed_crawler.log